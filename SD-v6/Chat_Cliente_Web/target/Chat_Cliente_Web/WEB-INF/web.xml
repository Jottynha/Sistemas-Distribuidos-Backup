
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Chat Distribuido Web</display-name>

    <!-- Comunicacao com o middleware exclusivamente por HTTPS. -->
    <context-param>
        <param-name>middleware.baseUrl</param-name>
        <param-value>https://127.0.0.1:8443</param-value>
    </context-param>

    <context-param>
        <param-name>middleware.publicBaseUrl</param-name>
        <param-value>https://10.142.98.144:8443</param-value>
    </context-param>

    <context-param>
        <param-name>middleware.backupPublicBaseUrl</param-name>
        <param-value>https://10.142.98.144:8443</param-value>
    </context-param>

    <!-- Coletor de logs integrado ao servidor HTTPS. -->
    <context-param>
        <param-name>log.collector.url</param-name>
        <param-value>https://127.0.0.1:8443/api/logs</param-value>
    </context-param>

    <context-param>
        <param-name>log.collector.publicUrl</param-name>
        <param-value>https://10.142.98.144:8443/api/logs</param-value>
    </context-param>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
